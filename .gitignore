# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.staging/
*.wasm
*.o
*.log
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# The DWG viewer bundle is generated by ios/web/build-for-ios.sh: 17 MB of build output.
# The placeholder index.html is kept so a fresh clone can still build.
ios/CADViewer/Sources/CADViewer/Resources/dwgviewer/*
!ios/CADViewer/Sources/CADViewer/Resources/dwgviewer/index.html

# Leftover scratch from the local wasm build (the harness now lives in verification/)
ios/DXFGeometry/buildlog*.txt
ios/DXFGeometry/files*.txt
ios/DXFGeometry/native2018.json

# The geometry harnesses' own build products
verification/dxf-geometry-harness/*.wasm
verification/dxf-geometry-harness/buildlog*.txt
verification/dxf-geometry-harness/files*.txt
verification/dxf-geometry-harness/.staging/

# A local SwiftDXF checkout, used only by the wasm harness build. The package itself comes
# from GitHub as an SPM dependency; this is for machines that cannot fetch for wasm.
SwiftDXF/

# Scratch work: LibreDWG's CLI, converted samples, the throwaway viewer experiments, and
# the images the screenshot scripts write.
libredwg/
libredwg-win64.zip
out/
ml-example/
ff-test/
swift-test/
SwiftDXF-wasm/
*.svg
*.err
parse_err.txt
shots/native*.html

# macOS / Windows
.DS_Store
Thumbs.db
pe.txt
